:{$PORT:80}

root * /srv
encode gzip zstd
try_files {path} {path}/ {path}.html
file_server

redir / /en/ 302

# Partial HTML fragments (header/footer/modal) are fetched at runtime and
# CHANGE between deploys — they are NOT versioned assets, so they must get the
# short page cache, never the year-long immutable one.
@partials path /assets/partials/*
header @partials Cache-Control "public, max-age=300"

# Versioned static assets (css/js/img/fonts). Partials are excluded so a
# partial can never also match this rule — correctness does not depend on
# header-directive evaluation order.
@assets {
	path /assets/*
	not path /assets/partials/*
}
header @assets Cache-Control "public, max-age=31536000, immutable"

@html path *.html
header @html Cache-Control "public, max-age=300"
